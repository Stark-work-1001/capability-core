{
  "mcpServers": {
    "obsidian-rest": {
      "command": "D:/.my-agent/.plugin/obsidian-agent/mcp/.venv/Scripts/python.exe",
      "args": [
        "D:/.my-agent/.plugin/obsidian-agent/mcp/server_entry.py"
      ],
      "env": {
        "OBSIDIAN_API_KEY": "<paste the key from Obsidian > Settings > Local REST API>",
        "OBSIDIAN_HOST": "127.0.0.1",
        "OBSIDIAN_PORT": "27124",
        "OBSIDIAN_PROTOCOL": "https"
      }
    },
    "obsidian-cli": {
      "command": "D:/.my-agent/.plugin/obsidian-agent/mcp/.venv/Scripts/python.exe",
      "args": [
        "D:/.my-agent/.plugin/obsidian-agent/mcp/obsidian_cli_server.py"
      ],
      "env": {
        "OBSIDIAN_CLI": "C:/Program Files/Obsidian/Obsidian.com"
      }
    }
  }
}
